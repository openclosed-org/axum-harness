{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Topology",
  "description": "A deployment topology defining which deployables run where and how they connect",
  "type": "object",
  "required": ["name", "version", "deployables", "resources"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "deployables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "replicas"],
        "properties": {
          "name": { "type": "string", "description": "Deployable name" },
          "replicas": { "type": "integer", "minimum": 1 },
          "enabled": { "type": "boolean", "default": true },
          "config": {
            "type": "object",
            "description": "Deployable-specific configuration"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "enabled": { "type": "boolean", "default": true },
          "config": {
            "type": "object",
            "description": "Resource-specific configuration"
          }
        }
      }
    },
    "capability_bindings": {
      "type": "object",
      "description": "Capability-state/provider/resource bindings for this topology. Keys are capability keys such as database or cache.",
      "additionalProperties": {
        "type": "object",
        "required": ["state", "provider", "resource"],
        "properties": {
          "state": {
            "type": "string",
            "enum": ["disabled", "local_mock", "local_real", "external_single_node", "external_distributed"]
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9-]*$"
          },
          "resource": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "adapter": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9-]*$"
          },
          "secret_binding": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "provider_environment": {
            "type": "string"
          },
          "semantic_limits": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "string",
            "enum": ["declared", "checked", "tested", "proven"]
          }
        },
        "additionalProperties": false
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "gateway": { "type": "string" },
        "internal_dns": { "type": "string" },
        "exposed_ports": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    }
  }
}
