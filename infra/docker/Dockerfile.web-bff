# syntax=docker/dockerfile:1.7
# Multi-stage Dockerfile for the Web BFF service
#
# Build:
#   podman build -f infra/docker/Dockerfile.web-bff -t web-bff .
#
# Run:
#   podman run -p 3010:3010 --env-file /run/axum-harness/web-bff.env web-bff
#
# Uses distroless/cc because the default Rust build links dynamic system libraries.

# ── Stage 1: Builder ─────────────────────────────────────────
FROM rust:1.95-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy dependency definitions first for layer caching
COPY Cargo.toml Cargo.lock ./
COPY justfiles/ ./justfiles/
COPY Justfile ./

# Copy all workspace crates
COPY packages/ ./packages/
COPY services/ ./services/
COPY servers/ ./servers/
COPY workers/ ./workers/
COPY platform/ ./platform/
COPY tools/ ./tools/

# Build the Web BFF service only. Cache mounts keep repeated Podman builds fast
# without committing Cargo registry/git/target contents into the builder layer.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/app/target \
    cargo build --release --package web-bff && \
    mkdir -p /app/out && \
    cp /app/target/release/web-bff /app/out/web-bff

# ── Stage 2: Runtime (distroless/cc) ─────────────────────────
FROM gcr.io/distroless/cc-debian12:nonroot AS runtime

# Copy CA certificates for HTTPS (TLS, OIDC, external APIs)
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy the built binary
COPY --from=builder /app/out/web-bff /usr/local/bin/web-bff

WORKDIR /

EXPOSE 3010

ENV RUST_LOG=info,web-bff=debug
ENV APP_SERVER_HOST=0.0.0.0
ENV APP_SERVER_PORT=3010
ENV APP_DATABASE_URL=file:/tmp/web-bff.db

ENTRYPOINT ["/usr/local/bin/web-bff"]
